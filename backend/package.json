{
  "name": "backend",
  "version": "1.3.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "tsnd --poll --respawn --transpile-only ./src/index.ts",
    "build": "tsc",
    "lint": "echo '----- Checking Backend -----' && prettier --debug-check . && eslint --ext .ts . && echo '----- Done -----'",
    "fix": "prettier --write . && eslint --fix --ext .ts .",
    "test": "jest",
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js",
    "migration:generate": "npm run typeorm -- migration:generate -n",
    "migration:create": "npm run typeorm -- migration:create -n",
    "migration:run": "npm run typeorm -- migration:run -d ./src/datasource.ts",
    "migration:revert": "npm run typeorm -- migration:revert -d ./src/datasource.ts",
    "migration:show": "npm run typeorm -- migration:show -d ./src/datasource.ts"
  },
  "author": "Megakrash",
  "license": "ISC",
  "dependencies": {
    "@apollo/server": "^4.12.0",
    "argon2": "^0.41.1",
    "axios": "^1.7.7",
    "class-validator": "^0.14.1",
    "cookies": "^0.9.1",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "express": "^5.1.0",
    "graphql": "^16.10.0",
    "graphql-scalars": "^1.24.2",
    "graphql-ws": "^6.0.4",
    "graphql-yoga": "^5.13.4",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.10.1",
    "pg": "^8.15.0",
    "reflect-metadata": "^0.2.2",
    "tsconfig-paths": "^4.2.0",
    "type-graphql": "^2.0.0-beta.3",
    "typeorm": "^0.3.22",
    "uuid": "^11.1.0",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/cookies": "^0.9.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/nodemailer": "^6.4.17",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.31.0",
    "@typescript-eslint/parser": "^8.31.0",
    "eslint": "^9.25.1",
    "jest": "^29.7.0",
    "prettier": "3.5.3",
    "ts-jest": "^29.3.2",
    "ts-node-dev": "^2.0.0"
  }
}
